# render-ssti — profile renderer passing user input into a Jinja2 template.
FROM docker.io/library/python:3.12-slim
RUN pip install --no-cache-dir jinja2==3.1.6
RUN useradd -m -u 1001 app && mkdir -p /app
WORKDIR /app
COPY app/server.py /app/server.py
RUN echo "KEYSTONE{ssti-rce-PLACEHOLDER}" > /app/flag.txt \
 && chown app:app /app/flag.txt && chmod 600 /app/flag.txt
USER app
EXPOSE 8084
CMD ["python3", "/app/server.py"]
