# cache-open — unauthenticated Redis-style KV service, no bind/auth hardening.
FROM docker.io/library/python:3.12-slim
RUN useradd -m -u 1001 app && mkdir -p /data && chown app /data
WORKDIR /app
COPY app/server.py /app/server.py
RUN echo "KEYSTONE{open-cache-PLACEHOLDER}" > /data/flag.txt \
 && chown app:app /data/flag.txt && chmod 600 /data/flag.txt
USER app
EXPOSE 6379
CMD ["python3", "/app/server.py"]
