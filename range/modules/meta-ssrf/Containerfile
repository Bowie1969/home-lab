# meta-ssrf — webhook fetcher with a token-only blocklist (SSRF), plus a
# cloud-style metadata endpoint answering on the container's interfaces
# (link-local 169.254.169.254 reaches it) inside the container netns.
FROM docker.io/library/python:3.12-slim
RUN mkdir -p /app
WORKDIR /app
COPY app/server.py /app/server.py
RUN echo "KEYSTONE{ssrf-pivot-PLACEHOLDER}" > /app/flag.txt \
 && chmod 600 /app/flag.txt
EXPOSE 8086
CMD ["python3", "/app/server.py"]
